
{
  "name": "Miss Rose",
  "logo": "https://telegra.ph/file/48522f7be29b993a19e60.jpg",
  "description": "Telegram's sassiest group manager. Modular Telegram group management bot!",
  "keywords": [
    "telegram",
    "best",
    "group",
    "manager",
    "3"
  ],
  "repository": "https://github.com/FayasKKD/Miss-Rose-Bot",
  "env": {
    "ENV": {
      "description": "Setting this to ANYTHING will enable env variables",
      "value": "ANYTHING"
    },
    "TOKEN": {
      "description": "Your bot token, as a string.",
      "value": ""
    },
    "OWNER_ID": {
      "description": "An integer consisting of your owner ID",
      "value": ""
    },
    "OWNER_USERNAME": {
      "description": "Your username",
      "value": ""
    },
    "WEBHOOK": {
      "description": "Setting this to ANYTHING will enable webhooks when in env mode messages",
      "value": "ANYTHING"
    },
    "URL": {
      "description": "The Heroku App URL",
      "value": ""
    },
    "MESSAGE_DUMP": {
      "description": "Optional chat for saved messages",
      "value": "-1007777777777"
    },
    "SUDO_USERS": {
      "description": "Space separated sudo user IDs",
      "value": ""
    },
    "SUPPORT_USERS": {
      "description": "Space separated support user IDs",
      "value": ""
    },
    "WHITELIST_USERS": {
      "description": "Space separated whitelisted user IDs",
      "value": ""
    },
    "DONATION_LINK": {
      "description": "Optional donation link",
      "value": ""
    },
    "PORT": {
      "description": "Port to use for webhooks",
      "value": "8443"
    },
    "DEL_CMDS": {
      "description": "Delete unauthorized commands",
      "value": "True"
    },
    "STRICT_GBAN": {
      "description": "Enforce global bans",
      "value": "True"
    },
    "ALLOW_EXCL": {
      "description": "Allow exclamation marks for commands",
      "value": "True"
    },
    "BAN_STICKER": {
      "description": "Sticker file ID used when banning people",
      "value": "CAACAgQAAxkBAAEHAedfwdK1GHtSZe1Q0F0q6vWRsxL91gAC-QgAAoThEVJCGmPkkeA1_R4E"
    }
  },
"addons": [
  {
    "plan": "heroku-postgresql:essential-0",
    "options": {
      "version": "15"
    }
  }
]
